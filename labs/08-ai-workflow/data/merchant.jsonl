{"id": "drift-down-bag", "product": "Drift 600 Down Sleeping Bag", "price": 279, "never": [{"says": "-\\s?20", "why": "-20 C is the survival extreme, not a rating a buyer sleeps at."}, {"says": "goose", "why": "The fill is duck down."}, {"says": "vegan|synthetic", "why": "It is filled with down."}], "must": [{"says": "comfort", "what": "the comfort rating"}, {"says": "-\\s?4", "what": "the limit rating, -4 C"}]}
