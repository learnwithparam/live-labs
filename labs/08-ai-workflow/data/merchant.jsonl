{"id": "tarn-2p-tent", "product": "Tarn 2 Lightweight Tent", "price": 249, "never": [{"says": "\\b(?:4|four)[- ]season|winter|snow", "why": "The sheet says 3-season, not for snow or winter."}, {"says": "\\b(?:3|three)[- ](?:person|man)", "why": "It is a 2-person tent."}], "must": [{"says": "\\b(?:2|two)[- ](?:person|man)", "what": "its capacity, 2 person"}, {"says": "\\b3[- ]season", "what": "that it is 3-season"}]}
