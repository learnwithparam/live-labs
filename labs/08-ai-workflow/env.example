# Any OpenAI-compatible endpoint. OpenRouter reaches Mistral, Gemini, Claude and open models with one key.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Every step of the workflow and the one-prompt version use it, so the comparison is the shape, not the model.
LLM_MODEL=google/gemini-2.5-flash
