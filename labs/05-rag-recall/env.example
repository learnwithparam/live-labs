# No key: the three models run on this laptop's CPU through fastembed and download once (about 150 MB).
# The embedding model. A bigger one, like BAAI/bge-base-en-v1.5, is slower to index and may find more.
DENSE_MODEL=BAAI/bge-small-en-v1.5
# The keyword model: BM25 word weights as a sparse vector.
SPARSE_MODEL=Qdrant/bm25
# The cross-encoder that reorders the hybrid shortlist.
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
