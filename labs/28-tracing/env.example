# Any OpenAI-compatible endpoint. OpenRouter returns the billed cost of each generation, which is the invoice here.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Drafts replies with one tool and summarises threads: the cheap tool-capable tier is enough.
LLM_MODEL=openai/gpt-6-luna
# Jaeger's OTLP receiver and query API, as the README starts it with docker.
OTLP_ENDPOINT=http://127.0.0.1:8282/v1/traces
JAEGER_URL=http://127.0.0.1:8281
