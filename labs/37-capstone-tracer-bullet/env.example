# Any OpenAI-compatible endpoint. OpenRouter reaches many models with one key.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# A small, fast model: the slice makes two or three short calls per message inside an 8000 ms budget.
LLM_MODEL=nvidia/nemotron-3.5-lightning
# Where Jaeger takes spans (OTLP over HTTP) and serves its query API. The README starts it on these ports.
OTLP_ENDPOINT=http://127.0.0.1:8372/v1/traces
JAEGER_URL=http://127.0.0.1:8371
