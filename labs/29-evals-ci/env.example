# Any OpenAI-compatible endpoint. OpenRouter reaches OpenAI, Qwen and open models with one key.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# The model for every release file that does not name its own. It calls tools in a short loop,
# which the cheapest OpenAI model does reliably.
LLM_MODEL=openai/gpt-6-luna
