# Any OpenAI-compatible endpoint. OpenRouter returns the billed cost of each call, so the run's cost is the bill.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Writes short cited answers from a handful of chunks: the cheap tier is enough.
LLM_MODEL=openai/gpt-6-luna
# The OpenFGA server the README starts with docker, in memory.
FGA_API_URL=http://127.0.0.1:8129
