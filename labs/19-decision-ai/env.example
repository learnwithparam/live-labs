# Any OpenAI-compatible endpoint. OpenRouter returns the billed cost of each call, so the run's cost is the bill.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Only the naive baseline calls a model: cheap, and follows a JSON schema strictly. The decision model runs on your laptop.
LLM_MODEL=openai/gpt-6-luna
