# OpenRouter: one key reaches the primary model, the fallback model and the billing record.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# The slot the service tries first. A short work order needs the cheapest model that follows a format.
LLM_MODEL=nvidia/nemotron-3.5-lightning
# The slot used when the first is failing or its circuit breaker is open.
LLM_FALLBACK_MODEL=openai/gpt-6-luna
