# Any OpenAI-compatible endpoint. OpenRouter reaches many models with one key.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# The model for every candidate that does not name its own. A small, fast model is enough to read a
# short tenant message and fill five fields.
LLM_MODEL=nvidia/nemotron-3.5-lightning
