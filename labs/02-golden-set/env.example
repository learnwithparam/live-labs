# Any OpenAI-compatible endpoint. OpenRouter reaches Mistral, Gemini, Claude and open models with one key.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# The model this lab was measured on. For an offline run: LLM_BASE_URL=http://localhost:11434/v1, LLM_API_KEY=ollama, LLM_MODEL=qwen3:8b
LLM_MODEL=openai/gpt-6-luna
