# Any OpenAI-compatible endpoint. OpenRouter returns the billed cost of each call, so the report's cost is the bill.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Cheap, calls tools reliably and returns JSON on request. Every agent, the writer and the checker use it.
LLM_MODEL=openai/gpt-6-luna
