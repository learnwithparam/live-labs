# Any OpenAI-compatible endpoint. OpenRouter reaches OpenAI, Qwen and open models with one key.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# The listing assistant. A small open model: it answers on every property page, so it must be cheap.
LLM_MODEL=ibm-granite/granite-4.2-8b
# The model behind the rails. It reads every message under a written policy, so it can differ.
RAIL_MODEL=openai/gpt-6-luna
