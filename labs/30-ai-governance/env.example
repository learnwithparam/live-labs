# Any OpenAI-compatible endpoint. OpenRouter reaches OpenAI, Anthropic and open models with one key.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# No LLM_MODEL here: data/inventory.toml lists the models each system may call, and the gateway refuses
# any other. Every system runs on openai/gpt-6-luna, the cheapest model that writes a short reply well.
# The key that turns customer numbers into pseudonyms in the audit log. Leave it empty in the lab.
AUDIT_PSEUDONYM_KEY=
