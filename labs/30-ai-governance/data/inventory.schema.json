{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://larkspur.example/schemas/ai-inventory.json",
  "title": "Larkspur AI inventory",
  "type": "object",
  "required": ["system"],
  "additionalProperties": false,
  "properties": {
    "system": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "purpose", "owner", "talks_to_customers", "risk", "status", "models", "version"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,40}$" },
          "name": { "type": "string", "minLength": 3 },
          "purpose": { "type": "string", "minLength": 20 },
          "owner": { "type": "string", "pattern": "^[^,]+, .+$" },
          "talks_to_customers": { "type": "boolean" },
          "disclosure": { "type": "string" },
          "proposed_disclosure": { "type": "string" },
          "risk": { "enum": ["minimal", "limited", "high"] },
          "status": { "enum": ["live", "retired"] },
          "models": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9.:-]+$" } },
          "version": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["version", "from", "prompt"],
              "additionalProperties": false,
              "properties": {
                "version": { "type": "string", "pattern": "^[0-9]+$" },
                "from": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                "prompt": { "type": "string", "pattern": "^prompts/[a-z0-9-]+\\.txt$" }
              }
            }
          }
        }
      }
    }
  }
}
