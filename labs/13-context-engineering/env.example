# Any OpenAI-compatible endpoint. OpenRouter returns the billed cost and the cached tokens of each call.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# OpenAI models cache a repeated prompt start on their own. Through OpenRouter on 15 Oct 2026,
# DeepSeek V4.1 Flash and Gemini 3.8 Flash reported no cached tokens, and Claude Haiku 5.5 needs cache_control.
LLM_MODEL=openai/gpt-6-luna
