# Any OpenAI-compatible endpoint the LiteLLM proxy can reach. OpenRouter carries every model here on one key.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# The strong tier: every call goes here before the router. Reasoning model, good at policy and arithmetic.
LLM_MODEL=openai/gpt-6-luna
