# Any OpenAI-compatible endpoint for the replies. Speech runs on LiveKit Inference, billed to the LiveKit project.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Cheap and quick to its first token, which a caller hears as the gap before the agent speaks. It calls tools reliably.
LLM_MODEL=google/gemini-3.5-flash-lite
# Optional: TURN_DETECTION=vad ends a turn on silence alone instead of the turn detector model.
# Your LiveKit Cloud project: Settings, API keys. The URL ends in .livekit.cloud.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
