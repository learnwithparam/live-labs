# Any OpenAI-compatible endpoint. OpenRouter reaches OpenAI, Anthropic and open models with one key.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Reads one short contract per customer into a strict JSON schema. No tools, no vision, so the cheapest capable model.
LLM_MODEL=openai/gpt-6-luna
