# Any OpenAI-compatible endpoint. OpenRouter reaches Gemini, Claude and open models with one key.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Takes the order with four till tools. Every voice turn waits on it, so it must be fast, and it must
# read the order back before placing it.
LLM_MODEL=anthropic/claude-haiku-5.5
# Local speech to text through MLX. base.en hears a five second order in about 0.2 s;
# mlx-community/whisper-large-v3-turbo hears accents better and makes every turn slower.
STT_MODEL=mlx-community/whisper-base.en-mlx
