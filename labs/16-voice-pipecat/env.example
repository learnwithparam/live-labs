# Any OpenAI-compatible endpoint. OpenRouter reaches Gemini, Claude and open models with one key.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Takes the order with four till tools. Every voice turn waits on it, so a fast, cheap tool caller.
LLM_MODEL=openai/gpt-6-luna
# Local speech to text. small.en is quick on a laptop CPU; deepdml/faster-whisper-large-v3-turbo-ct2
# hears better and makes every turn slower.
STT_MODEL=small.en
