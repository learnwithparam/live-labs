# Any OpenAI-compatible endpoint. OpenRouter reaches Mistral, Gemini, Claude and open models with one key.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Drafts replies and runs the grounding check before a reply is sent: fast and cheap, it runs on every reply.
LLM_MODEL=google/gemini-2.5-flash-lite
# Reviews replies after they are sent. It runs on a sample, so a stronger model is affordable.
JUDGE_MODEL=google/gemini-2.5-flash
