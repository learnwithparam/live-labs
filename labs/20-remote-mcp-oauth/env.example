# Any OpenAI-compatible endpoint. OpenRouter reaches many models with one key.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Calls MCP tools for the assistant. Cheap, and reliable at tool calling.
LLM_MODEL=openai/gpt-6-luna
# For an offline run with Ollama: LLM_BASE_URL=http://127.0.0.1:11434/v1 and a tool-capable model.
