# Any OpenAI-compatible endpoint. OpenRouter reaches Gemini, Claude and open models with one key.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Reads the routing guide and picks a queue. Routing is a short job, so the cheapest capable model is enough.
LLM_MODEL=openai/gpt-6-luna
# The decision model, in the System One format. The default starts Strands Decider on this machine.
# A hosted System One endpoint works too: set its URL, key and model name.
DECISION_BASE_URL=http://127.0.0.1:8099
DECISION_API_KEY=
DECISION_MODEL=StrandsAgents/strands-decider-2B-hobson-v19
