# Any OpenAI-compatible endpoint. OpenRouter returns the billed cost of each call, so the run's cost is the bill.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Cheap, reads images, and follows a JSON schema strictly. Every photo, the vehicle check and the free-text estimate use it.
LLM_MODEL=openai/gpt-6-luna
