# Any OpenAI-compatible endpoint. OpenRouter reaches Mistral, Gemini, Claude and open models with one key.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Plans searches, checks what is missing and writes the answer, for plain and agentic RAG alike.
# It has to apply a rule to a situation, not just repeat it, so it is a step above the cheapest model.
LLM_MODEL=google/gemini-2.5-flash
# Grades each answer against the expert's points. It only runs in the review, so it can be stronger.
JUDGE_MODEL=google/gemini-2.5-flash
