# Any OpenAI-compatible endpoint. OpenRouter reaches OpenAI, Anthropic and open models with one key.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# A support reply from a short policy prompt: no tools, no vision, so the cheapest capable model.
LLM_MODEL=openai/gpt-6-luna
# The Langfuse in compose.yaml. These are its local defaults; change them for a Langfuse you run elsewhere.
LANGFUSE_BASE_URL=http://localhost:8270
LANGFUSE_PUBLIC_KEY=pk-lf-driftwell-local
LANGFUSE_SECRET_KEY=sk-lf-driftwell-local
