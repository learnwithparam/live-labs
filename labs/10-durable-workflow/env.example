# Any OpenAI-compatible endpoint. OpenRouter reaches Gemini, Claude and open models with one key.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Reads one refund request against the policy. A fast model that follows a schema is enough.
LLM_MODEL=google/gemini-2.5-flash
# A Temporal server. When nothing answers here, `refund` starts a local dev server for you.
# For Temporal Cloud, set your namespace's address here.
TEMPORAL_ADDRESS=127.0.0.1:7233
